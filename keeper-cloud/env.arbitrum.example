# Second keeper, Arbitrum seulement.
# Sur le VPS, dans le dossier du keeper déjà en service :
#   cp env.arbitrum.example .env.arbitrum
# Puis recopier depuis le .env Base déjà en place :
#   SUPABASE_URL, SUPABASE_KEY, PRIVATE_KEY, BACKEND_API_URL, INTERNAL_API_KEY
#   et N8N_WEBHOOK_URL / N8N_WEBHOOK_SECRET s'ils sont renseignés.
# Ne pas modifier le .env Base, ne pas redémarrer le keeper Base.

NETWORK=arbitrum
# App Alchemy dédiée, réseau Arbitrum One. Ne pas coller l'URL base-mainnet.
RPC_URL=https://arb-mainnet.g.alchemy.com/v2/VOTRE_CLE
PORT=3002
KEEPER_NAME=keeper-arbitrum
CHECK_INTERVAL=60000
SECONDS_PER_MONTH=2592000
DELAY_BETWEEN_PAYMENTS_MS=0
RECURRING_POST_CONFIRM_DELAY_MS=2000

SUPABASE_URL=
SUPABASE_KEY=
PRIVATE_KEY=
BACKEND_API_URL=
INTERNAL_API_KEY=

# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
